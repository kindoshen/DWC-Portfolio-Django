# Copy this file to .env and fill in real values. See README.md > Environment Variables
# for what each one does and which are required in production.
#
# Nothing here is loaded automatically by a library — however you get these into the
# process environment (a shell `export`, `docker compose --env-file`, your host's env-var
# dashboard) is up to your setup. Docker Compose reads this file's name (`.env`) by
# default, which is why it's named that instead of e.g. `.env.local`.

# --- Core ---
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# True for local development only. Leave unset/False everywhere else.
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- HTTPS hardening (only takes effect when DJANGO_DEBUG=False) ---
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_HSTS_SECONDS=31536000
DJANGO_BEHIND_PROXY=True

# --- Database ---
# Unset -> falls back to local db.sqlite3, fine for development.
# Format: postgres://user:password@host:port/dbname
DATABASE_URL=

# --- Email ---
# Unset DJANGO_EMAIL_HOST -> mail prints to the console instead of sending, fine for dev.
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=True
DJANGO_DEFAULT_FROM_EMAIL=Inquiry@DesignWithCory.com
DJANGO_CONTACT_NOTIFICATION_EMAIL=
DJANGO_ADMIN_EMAIL=
DJANGO_SERVER_EMAIL=

# --- Docker Compose only ---
# The host port the web container is published on (docker-compose.yml).
WEB_PORT=8000
POSTGRES_DB=designwithcory
POSTGRES_USER=designwithcory
POSTGRES_PASSWORD=
