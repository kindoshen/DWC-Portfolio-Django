# Production starting point — copy to .env on the server and fill in the blanks left below.
# See README.md > Environment Variables for what each one does.
#
# Nothing here is loaded automatically by a library — however you get these into the
# process environment (a real `.env` + your shell/OS, Docker Compose's `env_file`, your
# host's env-var dashboard) is up to your setup.
#
# DJANGO_SECRET_KEY, POSTGRES_PASSWORD, and DJANGO_EMAIL_HOST_PASSWORD are left blank on
# purpose — this file is committed to version control, so a real secret typed here would
# be public. Fill in your own for each deploy, right before pasting into your actual
# (gitignored) .env:
#   DJANGO_SECRET_KEY:         python -c "import secrets; print(secrets.token_urlsafe(50))"
#   POSTGRES_PASSWORD:         python -c "import secrets; print(secrets.token_urlsafe(24))"
#   DJANGO_EMAIL_HOST_PASSWORD: your Mailgun SMTP password, from the dashboard (see below)

# --- Core ---
DJANGO_SECRET_KEY=
# Must be False (or unset) in production — settings.py refuses to start without
# DJANGO_SECRET_KEY when this is False, which is the point.
DJANGO_DEBUG=False
# Comma-separated real domain(s), e.g. designwithcory.com,www.designwithcory.com
DJANGO_ALLOWED_HOSTS=designwithcory.com,www.designwithcory.com
# Comma-separated origins with scheme, e.g. https://designwithcory.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://designwithcory.com

# --- HTTPS hardening (takes effect because DJANGO_DEBUG=False above) ---
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_HSTS_SECONDS=31536000
# True when behind a load balancer/reverse proxy terminating TLS (the normal case).
DJANGO_BEHIND_PROXY=True

# --- Database ---
# Ignored when running via docker-compose.yml, which builds this from the POSTGRES_*
# values below instead. Set it directly only if deploying without Compose, e.g.:
# postgres://user:password@host:5432/dbname
DATABASE_URL=

# --- Email (Mailgun SMTP relay) ---
# Mailgun dashboard > Sending > Domain settings > SMTP credentials. Use the region that
# matches where your sending domain lives — smtp.mailgun.org (US) or
# smtp.eu.mailgun.org (EU) — a US domain's login will silently fail against the EU host.
# DJANGO_EMAIL_HOST_USER must be the login shown there for your domain, e.g.
# postmaster@mg.designwithcory.com — not your Mailgun account email.
DJANGO_EMAIL_HOST=smtp.mailgun.org
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=postmaster@mg.designwithcory.com
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=True
# Must be on the domain (or a verified subdomain) you added in Mailgun, with SPF/DKIM/
# DMARC DNS records set up per Mailgun's instructions — otherwise this gets sent as that
# domain but fails authentication and lands in spam or gets rejected outright.
DJANGO_DEFAULT_FROM_EMAIL=Inquiry@DesignWithCory.com
DJANGO_CONTACT_NOTIFICATION_EMAIL=
# Recommended in production: emails you a full traceback on any unhandled 500.
DJANGO_ADMIN_EMAIL=
DJANGO_SERVER_EMAIL=

# --- Docker Compose only ---
WEB_PORT=8000
POSTGRES_DB=designwithcory
POSTGRES_USER=designwithcory
POSTGRES_PASSWORD=
